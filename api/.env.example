CLOVER_ENV=production               # sandbox | production
ORDERING_ENABLED=false              # production defaults to off: menus only, POST /orders returns 503

# Per restaurant (each has its own Clover merchant)
ITALIAN_CLOVER_MERCHANT_ID=
ITALIAN_CLOVER_REST_TOKEN=          # REST API token: inventory, customers, merchant, orders, payments
ITALIAN_CLOVER_ECOMM_PRIVATE_TOKEN= # Ecommerce private token: Hosted Checkout + Ecommerce API
ITALIAN_CLOVER_WEBHOOK_SECRET=      # Hosted Checkout webhook signing secret (hcp_…)
ITALIAN_CLOVER_TAG=                 # empty for a real merchant; a tag only on the shared sandbox
# ITALIAN_MENU_EXCLUDE=             # regex of Clover category names to keep off the site

MEXICAN_CLOVER_MERCHANT_ID=
MEXICAN_CLOVER_REST_TOKEN=
MEXICAN_CLOVER_ECOMM_PRIVATE_TOKEN=
MEXICAN_CLOVER_WEBHOOK_SECRET=
MEXICAN_CLOVER_TAG=
# MEXICAN_MENU_EXCLUDE=

# MENU_EXCLUDE_TAGS=Liquor,Beer,Wine   # items with these Clover tags never go online

PORT=4000
ITALIAN_SITE_URL=http://localhost:3101   # https URLs enable Clover's redirect back to the site
MEXICAN_SITE_URL=http://localhost:3102
ADMIN_TOKEN=
